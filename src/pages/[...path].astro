---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import PlatformFilters from '../components/PlatformFilters.astro';
import SoftwareCard from '../components/SoftwareCard.astro';
import AirportCard from '../components/AirportCard.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { routes, software, airports, articles, tags, tagUrl, imageFor, releases, articleMinutes, dateLabel, type Route } from '../lib/content';
export function getStaticPaths() { return routes.map(route=>({ params: { path: decodeURIComponent(route.path.replace(/^\/|\/$/g,'')) }, props:{route} })); }
interface Props { route: Route; }
const { route } = Astro.props;
const s=route.software, a=route.airport, article=route.article;
const related=article ? articles.filter(x=>x.slug!==article.slug && x.tags.some(t=>article.tags.includes(t))).slice(0,3) : s ? articles.filter(x=>x.software.includes(s.slug)).slice(0,3) : articles.filter(x=>x.slug==='airport-plan-guide'||x.slug==='import-subscription'||x.slug==='clash-getting-started');
const crumbs = route.type==='software' ? [{text:'软件大全',href:'/software/'}] : route.type==='airport' ? [{text:'机场推荐',href:'/airports/'}] : route.type==='article'||route.type==='tag' ? [{text:'文章',href:'/articles/'}] : [];
const site=Astro.site!.href;
const breadcrumbSchema={ '@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{ '@type':'ListItem',position:1,name:'首页',item:site },...crumbs.map((c,i)=>({'@type':'ListItem',position:i+2,name:c.text,item:new URL(c.href,site).href})),{'@type':'ListItem',position:crumbs.length+2,name:route.title,item:new URL(route.path,site).href}] };
const schemas: Record<string,unknown>[]=[breadcrumbSchema];
if(s&&s.status!=='legacy') schemas.push({'@context':'https://schema.org','@type':'SoftwareApplication',name:s.name,operatingSystem:s.platforms.join(', '),applicationCategory:'UtilitiesApplication',url:new URL(route.path,site).href,downloadUrl:s.download});
if(article) schemas.push({'@context':'https://schema.org','@type':'Article',headline:article.title,description:article.description,datePublished:article.publishedAt,dateModified:article.updatedAt,image:new URL(imageFor(article.cover),site).href,author:{'@type':'Organization',name:'素Clash',url:site},mainEntityOfPage:new URL(route.path,site).href});
const chapterId=(i:number)=>`section-${i+1}`;
---
<Layout title={route.title} description={route.description} noindex={route.type==='search'} schema={schemas}>
<div class="container page-content">
  <nav class="breadcrumbs" aria-label="面包屑"><a href="/">首页</a>{crumbs.map(c=><><span>/</span><a href={c.href}>{c.text}</a></>)}<span>/</span><span>{route.title}</span></nav>
  {['software-list','download'].includes(route.type) && <>
    <div class="page-heading"><div><h1>{route.title}</h1><p>{route.description}</p></div><img src={imageFor(route.image)} alt="客户端与安装选择插画" width="540" height="320" /></div>
    <section data-filter-scope><div class="filters-bar"><PlatformFilters /><p class="filter-note">当前显示 <strong data-filter-count>{software.length}</strong> 个项目。选择软件后可查看下载与教程。</p></div><div class="grid three">{software.map(item=><SoftwareCard item={item} />)}</div><p class="empty-state" hidden data-filter-empty>没有匹配项目，试试其他系统。</p></section>
    {route.type==='download' && <section class="content-block" style="margin-top:35px"><h2>安装包怎样选？</h2><div class="grid three intro-panels"><div class="panel"><h3>先看操作系统</h3><p>Windows、macOS、Linux 和手机分别使用对应安装包。iOS 相关工具使用其项目或 App Store 入口。</p></div><div class="panel"><h3>再看处理器架构</h3><p>x64、arm64 与通用包按设备选择。Linux 用户还需检查发行版对应的安装格式。</p></div><div class="panel"><h3>保留现有配置</h3><p>升级和迁移前保存订阅入口与自定义规则，确认新客户端可用后再整理旧文件。</p></div></div><a class="link-text" href="/articles/clash-getting-started/">阅读完整安装教程</a></section>}
  </>}
  {s && <>
    <section class="detail-hero"><div><div class="detail-title"><span class="software-symbol large-symbol" style={`--symbol-color:${s.color}`}>{s.symbol}</span><div><h1>{s.name}</h1><p>{s.subtitle}</p></div></div><p class="detail-description">{s.description}</p><div class="tags">{s.platforms.map(p=><span class="tag blue">{p}</span>)}{s.status==='legacy'&&<span class="tag muted">历史版本</span>}</div><img class="detail-art" src={imageFor('tutorial')} alt={`${s.name}安装与使用示意插画`} width="900" height="600" /></div>
    <aside class="panel download-box"><h2>{s.download ? '下载与安装' : '迁移与替代'}</h2><p>{s.download ? '按自己的系统与架构，在项目发布入口选择安装包。' : '原项目没有可用发布入口，可先阅读迁移教程，再选择当前客户端。'}</p>
    {releases[s.slug] && <p><span class="tag blue">{releases[s.slug].version}</span><span> 发布于 {dateLabel(releases[s.slug].publishedAt)}</span></p>}
    {s.download && <a class="button full" href={s.download} target="_blank" rel="noopener"><Icon name="download" size={18} />前往官方下载<Icon name="external" size={14} /></a>}
    {s.official && <a class="button neutral full" href={s.official} target="_blank" rel="noopener">项目网站与文档</a>}
    <a class="button secondary full" href={`/articles/${s.slug}-guide/`}>阅读使用教程</a>{!s.download&&<a class="button full" href="/download/">选择替代客户端</a>}</aside></section>
    <div class="detail-layout"><div><section class="content-block"><h2>软件介绍</h2><p>{s.description}</p><ul class="feature-list">{s.features.map(f=><li><Icon name="check" size={16} />{f}</li>)}</ul></section><section class="content-block"><h2>安装与使用</h2><p>确认安装包与设备匹配，安装后导入自己的有效订阅，再选择代理组和连接方式。更换软件时保留旧配置，逐项验证自定义规则。</p><a class="link-text" href={`/articles/${s.slug}-guide/`}>查看 {s.name} 完整教程</a></section><section class="content-block"><h2>常见问题</h2><div class="faq-list">{s.faqs.map(f=><details><summary>{f.q}</summary><p>{f.a}</p></details>)}</div></section><section class="content-block"><h2>相关文章</h2><div class="grid two">{related.map(item=><ArticleCard item={item} />)}</div></section></div><aside class="sidebar"><div class="panel"><h2>继续了解</h2><div class="sidebar-links"><a href="/articles/import-subscription/">订阅导入与更新</a><a href="/articles/proxy-modes/">规则、全局与直连</a><a href="/articles/tun-system-proxy/">TUN 与系统代理</a><a href="/airports/">机场购买入口</a></div></div></aside></div>
  </>}
  {['airports','ranking','cheap'].includes(route.type) && <>
    <div class="page-heading"><div><h1>{route.title}</h1><p>{route.description}</p></div><img src={imageFor('airports')} alt="飞机、樱花与网络服务选购插画" width="540" height="320" /></div>
    {route.type==='airports' && <><div class="grid three intro-panels"><div class="panel"><h3>新手先看短期</h3><p>先了解客户端与套餐格式，比较短期使用成本，再决定是否选择更长周期。</p></div><div class="panel"><h3>按设备选方案</h3><p>电脑、手机和平板分别确认适配方式，同时核对在线设备与连接条件。</p></div><div class="panel"><h3>按用量选流量</h3><p>日常浏览和长时间视频的需求不同，先估算月流量，再看重置与有效期。</p></div></div><div class="grid three">{airports.map(item=><AirportCard item={item} />)}</div></>}
    {route.type==='ranking' && <><p class="section-description">集中查看购买入口，当前按名单顺序展示。</p><div class="table-wrap"><table class="airport-table"><thead><tr><th>机场</th><th>套餐</th><th>选购方向</th><th>详情</th><th>购买</th></tr></thead><tbody>{airports.map(item=><tr><td><a class="table-name" href={`/airports/${item.slug}/`}><span class="airport-symbol" style={`--symbol-color:${item.color}`}>{item.symbol}</span><span><strong>{item.name}</strong><small>{item.domain}</small></span></a></td><td class="muted-cell">{item.plans.length ? `${item.plans.length} 种方案` : '查看当前套餐'}</td><td class="muted-cell">{item.focus}</td><td><a class="link-text" href={`/airports/${item.slug}/`}>查看详情</a></td><td><a class="button small" href={`https://${item.domain}`} target="_blank" rel="sponsored noopener">前往购买</a></td></tr>)}</tbody></table></div></>}
    {route.type==='cheap' && <><div class="grid three intro-panels"><div class="panel"><h3>看实际总价</h3><p>月付、季度和年付先换算到同一周期。折算月价较低，不一定意味着首次付款更少。</p></div><div class="panel"><h3>看有效流量</h3><p>关注能用到的流量和有效期，低价但用不到的额度不一定划算。</p></div><div class="panel"><h3>看使用条件</h3><p>设备、连接数、配置格式和退款条件都会影响实际成本，付款前逐项确认。</p></div></div><section class="content-block"><h2>低预算选购步骤</h2><p>先确定每月预算和用量，再进入购买页比较实际套餐。没有可比的当前价格时，不按机场名称或旧宣传判断最低价。</p><a class="link-text" href="/articles/airport-plan-guide/">阅读月付与流量包选购指南</a></section><div class="grid three">{airports.map(item=><AirportCard item={item} />)}</div></>}
    <section class="content-block" style="margin-top:35px"><h2>机场选购与使用教程</h2><div class="grid three">{related.map(item=><ArticleCard item={item} />)}</div></section>
  </>}
  {a && <>
    <section class="detail-hero"><div><div class="detail-title"><span class="airport-symbol large-symbol" style={`--symbol-color:${a.color}`}>{a.symbol}</span><div><h1>{a.name}</h1><p>{a.domain}</p></div></div><p class="detail-description">{a.description}</p><img class="detail-art" src={imageFor('airports')} alt={`${a.name}机场套餐选购插画`} width="900" height="600" /></div><aside class="panel download-box"><h2>购买与订阅</h2><p>查看当前套餐、订单与订阅选项。</p><a class="button full" href={`https://${a.domain}`} target="_blank" rel="sponsored noopener">前往购买<Icon name="external" size={16} /></a><a class="button secondary full" href="/articles/airport-plan-guide/">先看套餐选购指南</a><span class="domain">{a.domain}</span></aside></section>
    <section class="content-block"><h2>套餐选择</h2>{a.plans.length ? <div class="grid three plans">{a.plans.map(plan=><div class="panel"><h3>{plan.name}</h3><p class="price">¥{plan.price}<span class="tag">{plan.period}</span></p><p>{plan.traffic} GB</p><ul>{plan.details.map(d=><li>{d}</li>)}</ul><a class="button full" href={`https://${a.domain}`} rel="sponsored noopener" target="_blank">前往购买</a></div>)}</div> : <div class="plan-empty"><div><h3>按自己的预算与流量选择</h3><p>当前价格、有效期和可用权益在购买页面查看。月付、长期和流量包按相同使用周期比较。</p></div><a class="button" href={`https://${a.domain}`} target="_blank" rel="sponsored noopener">查看当前套餐</a></div>}</section>
    <section class="content-block"><h2>购买后怎样开始使用？</h2><div class="grid three intro-panels"><div class="panel"><h3>查看订单</h3><p>确认套餐已经生效，核对有效期和当前额度，再获取订阅入口。</p></div><div class="panel"><h3>选择客户端</h3><p>按自己的系统下载安装，使用对应的订阅格式导入配置。</p></div><div class="panel"><h3>检查连接</h3><p>启用配置、选择节点，再按设备开启系统代理或 VPN 权限。</p></div></div><a class="link-text" href="/download/">去下载客户端</a></section><section class="content-block"><h2>相关文章</h2><div class="grid three">{related.map(item=><ArticleCard item={item} />)}</div></section>
  </>}
  {['articles','tag'].includes(route.type) && <>
    <div class="page-heading"><div><h1>{route.title}</h1><p>{route.description}</p></div></div><section data-filter-scope>{route.type==='articles' && <div class="filters-bar"><div class="filter-controls" role="group" aria-label="按文章类型筛选">{['all','教程','FAQ','测评'].map((c,i)=><button type="button" class:list={{active:i===0}} data-filter="category" data-value={c} aria-pressed={i===0?'true':'false'}>{c==='all'?'全部文章':c}</button>)}</div></div>}<div class="grid three">{articles.filter(item=>!route.tag||item.tags.includes(route.tag)).map(item=><ArticleCard item={item} />)}</div><p class="empty-state" hidden data-filter-empty>暂时没有匹配文章，试试其他分类。</p></section><section class="content-block" style="margin-top:35px"><h2>按标签阅读</h2><div class="tag-cloud">{tags.map(t=><a href={tagUrl(t)}>{t}</a>)}</div></section>
  </>}
  {article && <div class="article-layout"><article><header class="article-head"><span class:list={['tag',article.category==='FAQ'?'blue':article.category==='测评'?'green':'orange']}>{article.category}</span><h1>{article.title}</h1><div class="article-meta"><span>素Clash编辑</span><time datetime={article.publishedAt}>{dateLabel(article.publishedAt)}</time><span>约 {articleMinutes(article)} 分钟</span></div><p class="article-summary">{article.description}</p><img class="article-cover" src={imageFor(article.cover)} alt={`${article.title}主题插画`} width="1200" height="800" fetchpriority="high" /></header><div class="article-body">{article.sections.map((section,i)=><section id={chapterId(i)}><h2>{section.heading}</h2>{section.paragraphs.map(p=><p>{p}</p>)}{section.list?.length&&<ol>{section.list.map(li=><li>{li}</li>)}</ol>}{section.links?.length&&<div class="article-links">{section.links.map(link=><a class="link-text" href={link.href}>{link.text}</a>)}</div>}</section>)}</div><div class="article-footer"><div class="tags">{article.tags.map(t=><a class="tag blue" href={tagUrl(t)}>{t}</a>)}</div><div class="pagination-links"><a href="/articles/">返回文章中心</a>{article.software[0]&&<a href={`/software/${article.software[0]}/`}>查看相关软件</a>}</div></div><section class="content-block" style="margin-top:35px"><h2>相关阅读</h2><div class="grid two">{related.map(item=><ArticleCard item={item} />)}</div></section></article><aside class="sidebar article-sidebar"><div class="panel toc"><h2>本文目录</h2><ol>{article.sections.map((section,i)=><li><a href={`#${chapterId(i)}`}>{section.heading}</a></li>)}</ol><div class="sidebar-links" style="margin-top:25px"><a href="/download/">客户端下载中心</a><a href="/airports/">机场购买入口</a></div></div></aside></div>}
  {route.type==='search' && <><div class="page-heading"><div><h1>找到你需要的内容</h1><p>搜索客户端、机场名称或使用问题。</p></div></div><form class="search-box" id="site-search" role="search"><label class="sr-only" for="search-query">输入搜索词</label><input id="search-query" name="q" type="search" placeholder="例如：Windows、樱花猫、订阅导入" required /><button class="button" type="submit"><Icon name="search" size={17} />搜索</button></form><p class="search-status" id="search-status" aria-live="polite">输入关键词开始搜索。</p><div id="search-results"></div><noscript><p>搜索需要 JavaScript。也可以直接浏览 <a class="link-text" href="/software/">软件大全</a> 或 <a class="link-text" href="/articles/">文章中心</a>。</p></noscript><section class="content-block" style="margin-top:35px"><h2>热门入口</h2><div class="tag-cloud"><a href="/download/?platform=Windows">Windows 下载</a><a href="/articles/import-subscription/">订阅导入</a><a href="/articles/windows-connection/">连接故障</a><a href="/ranking/">机场榜单</a></div></section></>}
  {route.type==='about' && <><div class="page-heading"><div><h1>关于素Clash</h1><p>把客户端下载、使用教程和机场选购放在一起。</p></div></div><div class="content-block"><h2>按设备找到下一步</h2><p>软件大全帮助区分平台和项目，下载中心连接各项目的发布入口，文章中心整理安装、订阅、分流和常见问题。机场栏目提供你需要比较的购买入口与选购方法。</p><p>客户端、配置和节点服务各自承担不同任务。先理解它们的关系，再按自己的设备和使用频率选择，可以减少安装与迁移时的反复尝试。</p><div class="hero-actions"><a class="button" href="/download/">选择客户端</a><a class="button secondary" href="/articles/">阅读教程</a></div></div></>}
</div>
<script>
  const form=document.querySelector<HTMLFormElement>('#site-search');
  if(form){
    const input=document.querySelector<HTMLInputElement>('#search-query')!;
    const status=document.querySelector<HTMLElement>('#search-status')!;
    const results=document.querySelector<HTMLElement>('#search-results')!;
    let index: {title:string;description:string;url:string;kind:string}[]|undefined;
    let revision=0;
    const search=async()=>{
      const current=++revision,query=input.value.trim();results.replaceChildren();
      if(!query){status.textContent='输入关键词开始搜索。';return;}
      status.textContent='正在搜索…';
      try{index??=await fetch('/search-index.json').then(r=>{if(!r.ok)throw new Error('index');return r.json()});
        if(current!==revision)return;
        const terms=query.toLocaleLowerCase().split(/\s+/);const found=index!.filter(item=>terms.every(t=>(item.title+' '+item.description).toLocaleLowerCase().includes(t)));
        status.textContent=found.length?`找到 ${found.length} 条相关内容`:'没有找到结果，试试软件名称或更短的关键词。';
        found.forEach(item=>{const link=document.createElement('a');link.className='search-result';link.href=item.url;const label=document.createElement('small');label.textContent=item.kind;const heading=document.createElement('h2');heading.textContent=item.title;const description=document.createElement('p');description.textContent=item.description;link.append(label,heading,description);results.append(link)});
      }catch{if(current===revision)status.textContent='搜索暂时无法加载，请刷新页面或使用栏目导航。';}
      const url=new URL(location.href);url.searchParams.set('q',query);history.replaceState(null,'',url);
    };
    form.addEventListener('submit',event=>{event.preventDefault();void search()});
    const q=new URLSearchParams(location.search).get('q');if(q){input.value=q;void search();}
  }
</script>
</Layout>
